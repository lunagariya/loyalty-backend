# Runtime
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster/database
# Shopify app credentials and URLs
SHOPIFY_API_KEY=replace_me
SHOPIFY_API_SECRET=replace_me
SHOPIFY_SCOPES=read_customers,write_customers,read_orders,write_discounts
SHOPIFY_APP_URL=https://your-backend.example.com
ADMIN_APP_URL=https://your-admin.example.com
SHOPIFY_API_VERSION=2026-07
# Customer JWT authentication
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
# HTTP security
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Loyalty settings
POINTS_EXPIRATION_ENABLED=true
POINTS_EXPIRATION_MONTHS=12
CRON_SCHEDULE=0 2 * * *
LOG_LEVEL=info
# Optional seed command settings
SEED_SHOP_DOMAIN=demo-loyalty.myshopify.com
SEED_RESET=false
